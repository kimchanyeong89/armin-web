# Exclude local install/build artifacts
node_modules/
.expo/
dist/
build/
coverage/
android/
ios/

# Exclude large web-app assets committed to the monorepo root
# (gitignore patterns match at any depth, so these cover armin-web-main/public/ etc.)
public/
downloads/
embedding_results/
workers/
google-cloud-sdk/
*.aab
*.csv
*.tar.gz
*.tgz

# Keep source and config
!App.tsx
!app.json
!babel.config.js
!metro.config.js
!package.json
!package-lock.json
!tsconfig.json
!eas.json
!.env
!.env.example
!README.md
!adapters/
!adapters/**
!assets/
!assets/**
!src/
!src/**
!scripts/
!scripts/**
!store/
!store/**
