{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "APP_ENV": "staging"
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "channel": "staging",
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6761988484",
        "appleTeamId": "VN6V69RK3W"
      },
      "android": {
        "serviceAccountKeyPath": "../../firebase-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
