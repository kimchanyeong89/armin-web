{
  "expo": {
    "name": "COLLY",
    "slug": "armin-mobile",
    "scheme": "com.armin.mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08070B"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.armin.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08070B"
      },
      "package": "com.armin.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8ba3bf1e-5aa7-4f08-8e55-7edbdcd45ca9"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/8ba3bf1e-5aa7-4f08-8e55-7edbdcd45ca9"
    },
    "plugins": [
      "expo-asset",
      "expo-build-properties",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
