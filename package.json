{
  "name": "armin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-search-index.cjs && node scripts/build-search-warm-prefix.cjs && npm run build:admin-lines",
    "build": "vite build && node scripts/postbuild-cleanup.cjs",
    "scrape:dia:collection": "node ./scripts/scrape-dia-collection.cjs",
    "scrape:high:collection": "node ./scripts/scrape-high-collection.cjs",
    "scrape:npg:floor3": "node ./scripts/scrape-npg-floor3.cjs",
    "scrape:npg:floor3:rooms1-18": "START_ROOM=1 END_ROOM=18 node ./scripts/scrape-npg-floor3.cjs",
    "scrape:npg:locations:1-11": "START_LOCATION=998 END_ROOM=11 node ./scripts/scrape-npg-location.cjs",
    "scrape:npg:locations:interactive": "HEADLESS=0 PAUSE_FOR_HUMAN=1 STORAGE_STATE=.npg-state.json START_LOCATION=998 END_ROOM=11 node ./scripts/scrape-npg-location.cjs",
    "scrape:jmoa:100": "node ./scripts/scrape-jmoa-collection-100.cjs",
