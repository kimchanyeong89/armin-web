    "scrape:kimtschang:all": "node ./scripts/scrape-kimtschang-yeul-collection-all.cjs",
    "scrape:dumoak:category8": "node ./scripts/scrape-dumoak-kim-work-category8.cjs",
    "scrape:dumoak:all": "node ./scripts/scrape-dumoak-kim-work-all.cjs",
    "scrape:dpm:paintings:100": "node ./scripts/scrape-dpm-intl-paintings-100.cjs",
    "scrape:dpm:paintings:all": "node ./scripts/scrape-dpm-intl-paintings-all.cjs",
    "scrape:nmc:highlights:100": "node ./scripts/scrape-chnmuseum-highlights-100.cjs",
