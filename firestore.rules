rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read of artworks collection (images and metadata) without auth
    match /artworks/{docId} {
      allow read: if true;
      // writes remain restricted to authenticated users with a custom claim 'admin' or via console
      allow write: if request.auth != null && (request.auth.token.admin == true);
    }

    // Allow authenticated users to read/write their own liked_artworks subcollection
    match /users/{userId}/liked_artworks/{artworkId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read/write their own counters subcollection
    match /users/{userId}/counters/{counterId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read/write their own profile subcollection
    match /users/{userId}/profile/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read/write their own liked_exhibitions subcollection
    match /users/{userId}/liked_exhibitions/{exhibitionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to create pending submissions
    match /pending_submissions/{submissionId} {
      // Anyone authenticated can create a submission
      allow create: if request.auth != null;
      // Only admin can read, update, delete (admin email checked in app code)
      allow read, update, delete: if request.auth != null;
    }

    // Allow read of exhibition_artworks (approved submissions), admin write
    match /exhibition_artworks/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Other collections default: no public access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
