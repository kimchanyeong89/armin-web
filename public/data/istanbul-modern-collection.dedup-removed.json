  "artworks": [
    {
      "id": "istanbul-modern-i-m-from-berlin",
      "objectNumber": "",
      "title": "I’m from Berlin",
      "artist": "Ardan Özmenoğlu",
      "date": "2015",
      "year": 2015,
      "medium": "Mixed media on post-it® notes",
      "dimensions": "113 x 90 cm",
      "category": "painting",
      "description": "Özmenoğlu reinterprets conventional objects and representations that generally go unnoticed, and transposes them onto post-it notes which she combines with an original printing technique she has been using since 2005. The material she uses allows her to step outside the two-dimensional tradition of painting and create multilayered surfaces. The artist’s series “manhole covers with designs”, from her silkscreen prints, makes reference to unnoticed worlds that consist of everyday spaces and functional areas in diverse cities. In this series, the invisible covers we pass over daily are moved into the viewer’s field of vision, into a space where they can be noticed. Designed specifically for each city, these unique objects shape and mark the visual identity of the city, while each also becomes a memory-image pertaining to urban life. Özmenoğlu produces her works like an everyday traveler who collects images as reminders, incorporating a variety of stories, memories and events pertaining to an individual and collective past.",
      "imageUrl": "https://pub-396fad1f96754c2f816f260faf970e63.r2.dev/artworks/istanbul-modern-collection/istanbul-modern-i-m-from-berlin-b45272cb-imageUrl.webp",
      "thumbnailUrl": "https://www.istanbulmodern.org/contents/piclib/collection/ardan-ozmenoglu-berliner-sag-alt-41554-305315.jpg",
      "onDisplay": false,
      "displayLocation": "",
      "sourceUrl": "https://www.istanbulmodern.org/en/collection/i-m-from-berlin",
      "metadata": {
        "museum_medium": "Painting",
        "artist_lifedates": "1979",
        "fund": "Istanbul Museum of Modern Art Collection",
        "src_size": "731x936"
      },
      "original_imageUrl": "https://www.istanbulmodern.org/contents/piclib/bigsize/collection/ardan-ozmenoglu-berliner-sag-alt-41554-305315.jpg"
    },
    {
      "id": "istanbul-modern-i-m-from-istanbul",
      "objectNumber": "",
      "title": "I’m from İstanbul",
      "artist": "Ardan Özmenoğlu",
      "date": "2015",
      "year": 2015,
      "medium": "Mixed media on post-it® notes",
      "dimensions": "113 x 90 cm",
      "category": "painting",
      "description": "Born in 1979 in Ankara, Ardan Özmenoğlu examines the meanings of representations that exist in everyday situations and urban life. She looks at the consumption habits of individuals and communities from the cultural perspective of a vast geography. She revisits heavily used images and clichés from popular culture as well as iconic images from politics and Turkish Yeşilçam melodramas within their original sociopolitical contexts. She problematizes the culture of consumption that exists within the visual sphere, while also making reference to the uniqueness and material values of art objects.\n\nÖzmenoğlu reinterprets conventional objects and representations that generally go unnoticed, and transposes them onto post-it notes which she combines with an original printing technique she has been using since 2005. The material she uses allows her to step outside the two-dimensional tradition of painting and create multilayered surfaces. The artist’s series “manhole covers with designs”, from her silkscreen prints, makes reference to unnoticed worlds that consist of everyday spaces and functional areas in diverse cities. In this series, the invisible covers we pass over daily are moved into the viewer’s field of vision, into a space where they can be noticed. Designed specifically for each city, these unique objects shape and mark the visual identity of the city, while each also becomes a memory-image pertaining to urban life. Özmenoğlu produces her works like an everyday traveler who collects images as reminders, incorporating a variety of stories, memories and events pertaining to an individual and collective past.",
      "imageUrl": "https://pub-396fad1f96754c2f816f260faf970e63.r2.dev/artworks/istanbul-modern-collection/istanbul-modern-i-m-from-istanbul-8e8caae9-imageUrl.webp",
      "thumbnailUrl": "https://www.istanbulmodern.org/contents/piclib/collection/ardan-ozmenoglu-istanbullu-sol-ust-41554-305315.jpg",
      "onDisplay": false,
      "displayLocation": "",
      "sourceUrl": "https://www.istanbulmodern.org/en/collection/i-m-from-istanbul",
      "metadata": {
        "museum_medium": "Painting",
        "artist_lifedates": "1979",
        "fund": "Istanbul Museum of Modern Art Collection",
        "src_size": "734x979"
      },
      "original_imageUrl": "https://www.istanbulmodern.org/contents/piclib/bigsize/collection/ardan-ozmenoglu-istanbullu-sol-ust-41554-305315.jpg"
    },
    {
      "id": "istanbul-modern-from-paintings-for-the-blind-series",
      "objectNumber": "",
      "title": "From Paintings for the Blind series",
      "artist": "Hüsamettin Koçan",
      "date": "2004-2005",
      "year": 2004,
      "medium": "Mixed media",
      "dimensions": "140 x 100 cm",
      "category": "painting",
      "description": "Hüsamettin Koçan studied art in the State School of Applied Fine Arts from 1966-1970. He returned there as a teaching assistant in 1975 and took part in the Salzburg Summer Academy of 1978.\n\nEarth symbolizes memory for Koçan, and is one of the most important features of his paintings, which use it as a symbol as well as a material, rooted as they are in Anatolia. The artist casts hands, eyes, and bodies like forms of expression present in mysticism and shamanism. To this end, he takes inspiration from the geography he inhabits and its symbols, and blends them with the new, as well as propositions regarding the future, to ultimately propose a new interpretation.\n\nThe works from Koçan’s “Paintings for Blinds” series stimulate the sense of touch rather than pursuing a completely visual experience. They exemplify the bringing together of insights gained through his research into Anatolian traditions and contemporary art. Referencing the allusive style of communication and the tradition of glass-bottom painting particular to Anatolia, Koçan creates the ridges evident in the works by placing earth under the canvas surface. Unlike his works in which he uses a symbolic language for the visual elements and motifs of Anatolian culture, history, and geography, here he uses earth as a more conceptual symbol for the idea of homeland.",
      "imageUrl": "https://pub-396fad1f96754c2f816f260faf970e63.r2.dev/artworks/istanbul-modern-collection/istanbul-modern-from-paintings-for-the-blind-series-68f7c1c2-imageUrl.webp",
      "thumbnailUrl": "https://www.istanbulmodern.org/contents/piclib/collection/146-kocan-h-kor-41554-305315.jpg",
      "onDisplay": false,
      "displayLocation": "",
      "sourceUrl": "https://www.istanbulmodern.org/en/collection/from-paintings-for-the-blind-series",
      "metadata": {
        "museum_medium": "Painting",
        "artist_lifedates": "1946",
        "fund": "Istanbul Museum of Modern Art Collection",
        "src_size": "789x1099"
      },
      "original_imageUrl": "https://www.istanbulmodern.org/contents/piclib/bigsize/collection/146-kocan-h-kor-41554-305315.jpg"
    },
